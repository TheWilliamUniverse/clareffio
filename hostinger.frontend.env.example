# Safe public/runtime values for the Clareffio Hostinger frontend Web App.
# Do NOT add backend secrets here.
# NODE_ENV is intentionally omitted so npm installs Vite/devDependencies during the Hostinger build.
VITE_APP_NAME=Clareffio
VITE_APP_URL=https://clareffio.willentreprises.com
VITE_API_BASE_URL=https://api.greffio.willentreprises.com
API_PUBLIC_URL=https://api.greffio.willentreprises.com
